# Qwen3.6 35B-A3B Heretic + DFlash + DDTree 標準設定
# コピーして .env として使う。秘密情報や HF_TOKEN はここに入れず、shell 側の環境変数で渡す。

DFLASH_MODEL=TheCluster/Qwen3.6-35B-A3B-Heretic-MLX-4bit
DFLASH_DRAFT=z-lab/Qwen3.6-35B-A3B-DFlash

# HF ログインなしで試したい場合の代替候補。
# 2026-05-13 時点では private=false / gated=false として確認済み。
# DFLASH_MODEL=Youssofal/Qwen3.6-35B-A3B-Abliterated-Heretic-MLX-4bit

# 外向き gateway は 8000、DFlash backend は 8001、DDTree は 8216。
DFLASH_GATEWAY_HOST=127.0.0.1
DFLASH_GATEWAY_PORT=8000
DFLASH_BACKEND_HOST=127.0.0.1
DFLASH_BACKEND_PORT=8001
DDTREE_HOST=127.0.0.1
DDTREE_PORT=8216

# アクセスが途切れてから backend を止める秒数。現行運用は 30 分。
DFLASH_GATEWAY_IDLE_SECONDS=1800

# coding agent 向けの現行標準候補。
DFLASH_PROFILE=balanced
DFLASH_MAX_CTX=24000
DFLASH_PREFILL_STEP_SIZE=4096
DFLASH_PREFIX_CACHE_MAX_ENTRIES=4
DFLASH_PREFIX_CACHE_MAX_BYTES=8589934592
DFLASH_PREFIX_CACHE_L2=0
DFLASH_PREFIX_CACHE_L2_MAX_BYTES=53687091200
DFLASH_DIAGNOSTICS=basic

# DDTree 側。
DDTREE_TREE_BUDGET=4
DDTREE_DEFAULT_MAX_TOKENS=4096
